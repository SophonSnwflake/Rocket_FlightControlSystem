    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Cortex Debug",
            "cwd": "${workspaceFolder}",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "executable": "./build/Debug/rocket_26.elf",
            "serverpath": "D:/Scoop/shims/openocd.exe",
            "request": "launch",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd"
        },
        {
            "name": "J-Link USB 烧录并调试（V8.38）",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/rocket_26.elf",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "device": "STM32F411CE",
            "interface": "swd",
            "serialNumber": "941000024",
            // "ipAddress": "10.111.97.77",
            "serverpath": "C:/Users/jiaha/AppData/Local/SEGGER/JLink_V838_portable/JLinkGDBServerCL.exe",
            "serverArgs": ["-speed", "100", "-vd"],
            "breakAfterReset": true
        },
        {
            "name": "J-Link Wi-Fi 附加调试（V8.38，已验证）",
            "type": "cortex-debug",
            "request": "attach",
            "preLaunchTask": "wait for J-Link Wi-Fi",
            "servertype": "jlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/rocket_26.elf",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "device": "STM32F411CE",
            "interface": "swd",
            "ipAddress": "10.111.97.77",
            "serverpath": "C:/Users/jiaha/AppData/Local/SEGGER/JLink_V838_portable/JLinkGDBServerCL.exe",
            "serverArgs": ["-speed", "100"]
        }
    ]
}
